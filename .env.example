# open-deepthink environment template
# Copy to .env and fill in values. Never commit real keys.
#   cp .env.example .env

# --- Provider ---
# openrouter | llamacpp
# DEFAULT_PROVIDER=openrouter

# OpenRouter (cloud). Prefer this name; API_KEY is accepted as a fallback.
OPENROUTER_API_KEY=
# API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=stepfun/step-3.5-flash:free
# OPENROUTER_EMBEDDING_MODEL=google/gemini-embedding-001

# llama.cpp server (local OpenAI-compatible)
# LLAMACPP_BASE_URL=http://localhost:8080/v1
# LLAMACPP_API_KEY=no-key-required
# LLAMACPP_MODEL=llama-3.2-1b-instruct
# LLAMACPP_EMBEDDING_URL=http://localhost:8080/v1

# --- Server ---
# HOST=0.0.0.0
# PORT=8000
# LOG_LEVEL=info
# LOG_JSON=false

# --- Generation defaults ---
# TEMPERATURE=0.7
# MAX_TOKENS=4096
# MAX_RETRIES=3

# --- QNN defaults ---
# QNN_MODE=auto
# QNN_MANUAL_LAYERS=3
# QNN_MANUAL_WIDTH=3
# QNN_NUM_EPOCHS=2
# QNN_ATTENTION_TOP_K=5
# QNN_ENABLE_SELF_ATTENTION=true

# --- QDAD defaults ---
# QDAD_GRID_SIZE=4
# QDAD_TEMPERATURE_SCALE=1.3
# QDAD_DENOISING_STEPS=3
# QDAD_NOUN_VERB_TEMPERATURE=0.6

# --- Paths ---
# OPEN_DEEPTHINK_ROOT=
# DISTILLATION_OUTPUT_DIR=distillation_output
# STATE_DIR=.deepthink-state

# Optional TOML config path (see deepthink.config.Settings)
# OPEN_DEEPTHINK_CONFIG=
